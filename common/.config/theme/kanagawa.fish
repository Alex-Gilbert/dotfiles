# Kanagawa: the terminal already is Kanagawa (foot, Ghostty), so fish keeps its
# own syntax colours (conf.d/fish_frozen_theme.fish) and the prompt uses names.
set -g theme_prompt_path blue
set -g theme_prompt_branch cyan
set -g theme_prompt_clean green
set -g theme_prompt_dirty red
set -g theme_prompt_bracket white
set -g theme_prompt_arrow green
set -g theme_prompt_badge black --background=blue

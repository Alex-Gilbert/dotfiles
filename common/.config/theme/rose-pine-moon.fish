# Rosé Pine Moon (https://rosepinetheme.com/palette). Hex throughout, so it
# shows in any terminal, including a Kanagawa one drawing this machine's panes.
# base 232136  muted 6e6a86  subtle 908caa  text e0def4  love eb6f92
# gold f6c177  rose ea9a97  pine 3e8fb0  foam 9ccfd8  iris c4a7e7  hl-med 44415a
set -g fish_color_normal e0def4
set -g fish_color_command c4a7e7
set -g fish_color_keyword 3e8fb0
set -g fish_color_param ea9a97
set -g fish_color_option ea9a97
set -g fish_color_quote f6c177
set -g fish_color_redirection 3e8fb0
set -g fish_color_end 908caa
set -g fish_color_operator 9ccfd8
set -g fish_color_escape 3e8fb0
set -g fish_color_error eb6f92
set -g fish_color_comment 6e6a86 --italics
set -g fish_color_autosuggestion 6e6a86
set -g fish_color_valid_path --underline
set -g fish_color_cwd ea9a97
set -g fish_color_user f6c177
set -g fish_color_host 9ccfd8
set -g fish_color_cancel e0def4
set -g fish_color_search_match --background=44415a
set -g fish_color_selection e0def4 --background=44415a
set -g fish_pager_color_prefix c4a7e7 --bold
set -g fish_pager_color_completion e0def4
set -g fish_pager_color_description 908caa
set -g fish_pager_color_progress 232136 --background=c4a7e7
set -g fish_pager_color_selected_background --background=44415a

set -g theme_prompt_path 9ccfd8
set -g theme_prompt_branch c4a7e7
set -g theme_prompt_clean 9ccfd8
set -g theme_prompt_dirty eb6f92
set -g theme_prompt_bracket 6e6a86
set -g theme_prompt_arrow ea9a97
set -g theme_prompt_badge 232136 --background=c4a7e7 --bold

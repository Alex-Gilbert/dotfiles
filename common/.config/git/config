# Shared git config.
#
# git reads BOTH this file and ~/.gitconfig. ~/.gitconfig is gitignored here
# because it holds per-machine identity (email, signing key, credential
# helpers), and any single-valued setting there overrides what's below — so
# machine-local overrides keep working without editing this file.
#
# Requires git-delta. It's in the package lists in scripts/setup-{linux,macos}.sh,
# so ./bootstrap.sh installs it.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true          # n / N jumps between files, like less
	line-numbers = true
	hyperlinks = true
	syntax-theme = kanagawa-wave

	# Match the kanagawa colourscheme used in nvim.
	minus-style                   = syntax "#43242b"
	minus-emph-style              = syntax "#672d3f"
	plus-style                    = syntax "#2b3328"
	plus-emph-style               = syntax "#3f5a35"
	line-numbers-minus-style      = "#c34043"
	line-numbers-plus-style       = "#76946a"
	line-numbers-zero-style       = "#54546d"
	file-style                    = bold "#7e9cd8"
	file-decoration-style         = "#54546d" ul
	hunk-header-decoration-style  = "#54546d" box

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default
	algorithm = histogram

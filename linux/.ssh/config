# Work SSH
Host w.github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/abt_ed25519
  IdentitiesOnly yes

Host liora.github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/id_ed25519_shiny
  IdentitiesOnly yes

# Personal SSH
Host p.github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/abt_ed25519
  IdentitiesOnly yes

Host github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/abt_ed25519
  IdentitiesOnly yes

# Softserve
Host softadmin
    HostName nas
    Port 23231
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

# Softserve
Host soft
    HostName nas
    Port 23231
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Private Git Direct
Host nas
    HostName nas
    User adminadmin
    Port 22
    IdentityFile ~/.ssh/id_rsa_nas
    IdentitiesOnly yes

# Gitea over 10 GbE direct subnet (nas → 10.10.10.2 via /etc/hosts).
Host gitea
    HostName nas
    Port 2222
    User git
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

# Gitea via Tailscale (when away from home).
Host gitea-tail
    HostName gilberthouse.story-pike.ts.net
    Port 2222
    User git
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

Host liora.github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/id_ed25519_shiny
  IdentitiesOnly yes

# Personal SSH
Host p.github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/abt_ed25519
  IdentitiesOnly yes

Host github.com
  HostName github.com
  AddKeysToAgent yes
  User git
  IdentityFile ~/.ssh/abt_ed25519
  IdentitiesOnly yes

# Softserve
Host softadmin
    HostName nas
    Port 23231
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

# Softserve
Host soft
    HostName nas
    Port 23231
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes

# Private Git Direct
Host nas
    HostName nas
    User adminadmin
    Port 22
    IdentityFile ~/.ssh/id_rsa_nas
    IdentitiesOnly yes

# Gitea over the 10 GbE home LAN (nas → 192.168.1.200 via fiber switch,
# /etc/hosts). Old 10.10.10.x point-to-point link retired 2026-05-30.
Host gitea
    HostName nas
    Port 2222
    User git
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

# Gitea via Tailscale (when away from home).
Host gitea-tail
    HostName gilberthouse.story-pike.ts.net
    Port 2222
    User git
    IdentityFile ~/.ssh/id_rsa_personal
    IdentitiesOnly yes

Host ppu-lin
    HostName 172.235.56.206
    Port 22
    User root
    IdentityFile ~/.ssh/abt_ed25519
    IdentitiesOnly yes

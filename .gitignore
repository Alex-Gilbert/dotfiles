# Machine-local git identity (email/signing key differ per machine).
.gitconfig

# Machine-local SSH topology; encrypted keys remain tracked separately.
linux/.ssh/config
macos/.ssh/config

# Nushell history is per-machine state.
.config/nushell/history.sqlite3
.config/nushell/history.sqlite3-shm
.config/nushell/history.sqlite3-wal
.config/nushell/history.txt

# TPM clones plugins in-place.
common/.config/tmux/plugins

# ---------------------------------------------------------------------------
# fisher-installed plugin files.
#
# ~/.config/fish/{functions,completions,conf.d} are stow symlinks into this
# repo, so `fisher install` writes plugin code straight into the working tree.
# common/.config/fish/fish_plugins is the source of truth — `fisher update`
# reinstalls everything below on any machine. Listed explicitly rather than
# globbed so hand-written functions in the same directories stay tracked.
# ---------------------------------------------------------------------------

# jorgebucaran/fisher
common/.config/fish/functions/fisher.fish
common/.config/fish/completions/fisher.fish

# jorgebucaran/autopair.fish
common/.config/fish/functions/_autopair_backspace.fish
common/.config/fish/functions/_autopair_insert_left.fish
common/.config/fish/functions/_autopair_insert_right.fish
common/.config/fish/functions/_autopair_insert_same.fish
common/.config/fish/functions/_autopair_tab.fish
common/.config/fish/conf.d/autopair.fish

# patrickf1/fzf.fish
common/.config/fish/functions/_fzf_configure_bindings_help.fish
common/.config/fish/functions/_fzf_extract_var_info.fish
common/.config/fish/functions/_fzf_preview_changed_file.fish
common/.config/fish/functions/_fzf_preview_file.fish
common/.config/fish/functions/_fzf_report_diff_type.fish
common/.config/fish/functions/_fzf_report_file_type.fish
common/.config/fish/functions/_fzf_search_directory.fish
common/.config/fish/functions/_fzf_search_git_log.fish
common/.config/fish/functions/_fzf_search_git_status.fish
common/.config/fish/functions/_fzf_search_history.fish
common/.config/fish/functions/_fzf_search_processes.fish
common/.config/fish/functions/_fzf_search_variables.fish
common/.config/fish/functions/_fzf_wrapper.fish
common/.config/fish/functions/fzf_configure_bindings.fish
common/.config/fish/conf.d/fzf.fish
common/.config/fish/completions/fzf_configure_bindings.fish

# evanlucas/fish-kubectl-completions
common/.config/fish/completions/kubectl.fish

# halostatue/fish-docker
common/.config/fish/conf.d/halostatue_fish_docker.fish
common/.config/fish/completions/docker.fish
common/.config/fish/completions/docker-compose.fish

# jorgebucaran/nvm.fish
common/.config/fish/functions/_nvm_index_update.fish
common/.config/fish/functions/_nvm_list.fish
common/.config/fish/functions/_nvm_version_activate.fish
common/.config/fish/functions/_nvm_version_deactivate.fish
common/.config/fish/functions/nvm.fish
common/.config/fish/conf.d/nvm.fish
common/.config/fish/completions/nvm.fish

# ---------------------------------------------------------------------------
# makepkg build output. Only PKGBUILD and the hand-written sources alongside it
# belong in git; src/ and pkg/ are regenerated by every build.
# ---------------------------------------------------------------------------
linux/custom-aur-packages/*/src/
linux/custom-aur-packages/*/pkg/
linux/custom-aur-packages/*/*.pkg.tar.*

#!/usr/bin/env bash
# Use the separately built helper that preserves explicit character-device grants.
set -euo pipefail
binary=/home/alex/dev/codex-gpu-pass-through/codex-rust-v0.161.0/codex-rs/target/debug/codex
if [[ ! -x "$binary" ]]; then
    echo "Missing GPU-enabled Codex: $binary" >&2
    exit 1
fi
exec "$binary" --no-daemon \
    -c 'permissions.dev.filesystem./dev/nvidia0="write"' \
    -c 'permissions.dev.filesystem./dev/nvidiactl="write"' \
    -c 'permissions.dev.filesystem./dev/nvidia-modeset="write"' \
    -c 'permissions.dev.filesystem./dev/nvidia-uvm="write"' \
    -c 'permissions.dev.filesystem./dev/nvidia-uvm-tools="write"' \
    -c 'permissions.dev.filesystem./dev/dri/renderD128="write"' \
    "$@"

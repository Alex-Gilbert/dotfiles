#!/usr/bin/env python3
"""Waybar mic level meter for setting recording gain. Click the module to toggle it.

Off: a dim mic icon, and the mic is not opened. On: live peak level of MIC (default the Scarlett 2i4,
input 1) as a bar plus dBFS, with a 1.5 s peak hold. CSS classes:
  off | low (peaks under -24) | good (-24 to -6, the voice-over target is -10 to -6) | hot (-6 to -1) | clip (-1 and up)

  waybar-mic-meter          stream JSON lines for a Waybar custom module (no interval)
  waybar-mic-meter toggle   switch the meter on or off
"""
import json, math, os, struct, subprocess, sys, time
from pathlib import Path

MIC = os.environ.get('MIC_METER_SOURCE', 'alsa_input.usb-Focusrite_Scarlett_2i4_USB-00.HiFi__Mic1__source')
FLAG = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / 'waybar-mic-meter.on'
RATE, BLOCK, HOLD = 16000, 1600, 1.5          # 100 ms blocks, peak hold in seconds
BARS = ' ▁▂▃▄▅▆▇█'


def emit(text, cls, tip):
    print(json.dumps({'text': text, 'class': cls, 'tooltip': tip}, ensure_ascii=False), flush=True)


def meter():
    rec = subprocess.Popen(['pw-record', '--target', MIC, '--rate', str(RATE), '--channels', '1', '--format', 'f32', '-'],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    held, held_at = -90.0, 0.0
    try:
        while FLAG.exists():
            buf = rec.stdout.read(BLOCK * 4)
            if not buf:
                emit('󰍭 no input', 'off', f'cannot read {MIC}'); time.sleep(1); return
            peak = max(abs(v) for v in struct.unpack(f'{len(buf) // 4}f', buf)) or 1e-9
            db, now = 20 * math.log10(peak), time.monotonic()
            if db >= held or now - held_at > HOLD: held, held_at = db, now
            n = max(0, min(8, round((held + 60) / 60 * 8)))                      # -60..0 dBFS across 8 steps
            cls = 'clip' if held >= -1 else 'hot' if held >= -6 else 'good' if held >= -24 else 'low'
            emit(f'󰍬 {BARS[n]}{BARS[max(0, n - 2)]} {held:5.1f}', cls,
                 'Mic level (peak, dBFS). Voice-over target: loudest words around -10 to -6.\nClick to turn the meter off.')
    finally:
        rec.terminate()


def main():
    if sys.argv[1:] == ['toggle']:
        FLAG.unlink() if FLAG.exists() else FLAG.touch(); return
    while True:
        if FLAG.exists(): meter()
        else:
            emit('󰍭', 'off', 'Mic level meter is off. Click to show the live level for setting gain.')
            while not FLAG.exists(): time.sleep(0.3)


if __name__ == '__main__':
    main()

#!/usr/bin/env bash
# screen-record — 4K30 X11 grab (no cursor: cursor-render draws it as its own layer) + desktop audio + mic + key/mouse log, as one session dir:
#   video.mkv     track 1 = desktop sound (default sink monitor), track 2 = mic (default source)
#   events.jsonl  key/mouse events, `t` = seconds into video.mkv (see input-log)
#   ffmpeg.log
# then cursor.mov, transcript.json, markers.json, timeline.otio (see the post steps at the end)
# NVENC so the CPU stays free. Audio-first: big input queues, lossless PCM (nothing
# to encode/stall), aresample fills any clock gap instead of skipping. MKV, so a
# crash still leaves a playable file. Stop with q (or Ctrl-C).
set -euo pipefail
dir=${1:-$HOME/Videos/rec-$(date +%F_%H-%M-%S)}
mkdir -m 700 "$dir"
sink=$(pactl get-default-sink).monitor
mic=$(pactl get-default-source)
geo=$(xdpyinfo | awk '/dimensions:/{print $2}')
echo "recording $geo -> $dir"

"$(dirname "$0")/input-log" "$dir" &
logger=$!
ffmpeg -hide_banner -stats \
  -thread_queue_size 1024 -f x11grab -draw_mouse 0 -framerate 30 -video_size "$geo" -i "${DISPLAY:-:0}" \
  -thread_queue_size 8192 -f pulse -fragment_size 4096 -i "$sink" \
  -thread_queue_size 8192 -f pulse -fragment_size 4096 -i "$mic" \
  -map 0:v -map 1:a -map 2:a \
  -c:v hevc_nvenc -preset p5 -tune hq -rc vbr -cq 18 -b:v 0 -pix_fmt yuv420p \
  -af aresample=async=1000 -c:a pcm_s24le -ar 48000 \
  "$dir/video.mkv" 2> >(tee "$dir/ffmpeg.log" >&2) || true
kill "$logger"; wait "$logger" || true
echo "recorded: $dir ($(wc -l < "$dir/events.jsonl") input events)"

# post: cursor layer, transcript, spoken Mark:/Delete mark -> Kdenlive markers.
# Each step is rerunnable by hand; a failure (e.g. speech server down) keeps the recording.
here=$(dirname "$0")
for step in cursor-render rec-transcribe rec-markers; do
    "$here/$step" "$dir" || echo "screen-record: $step failed, rerun: $here/$step $dir" >&2
done
echo "Kdenlive: new project ${geo} 30fps, Project > Import > OpenTimelineIO > $dir/timeline.otio"

#!/bin/sh
# Save a native-resolution region, then copy or annotate it.
set -eu
action=${1:-copy}
case "$action" in copy|annotate) ;; *) echo 'Usage: screenshot [copy|annotate]' >&2; exit 2 ;; esac
area=$(slurp) || exit 0
directory="$HOME/Pictures/screenshots"
mkdir -p "$directory"
file=$(mktemp "$directory/Screenshot-$(date +%F-%H%M%S)-XXXXXX.png")
if ! grim -g "$area" "$file"; then
    rm -f "$file"
    exit 1
fi
if [ "$action" = annotate ]; then
    exec pinta "$file"
fi
wl-copy --type image/png < "$file"
notify-send 'Screenshot saved and copied' "$file"

#!/usr/bin/env python3
"""Fit and align for niri, matching Paneru's Hyper-m / Hyper-n on macOS.

  niri-fit fit      (Hyper+M) one-shot: share the screen evenly between the
                    focused workspace's columns
  niri-fit align    (Hyper+N) line the columns up from the left edge and stop
                    auto-centering on this workspace; again to bring it back
  niri-fit split    (Hyper+V) the next window opens below the focused one, in
                    its column, instead of in a new column; again to cancel
  niri-fit watch    (spawned at startup) follow workspace switches and turn
                    centering off only while an aligned workspace is focused;
                    carry out an armed split when the next window opens

niri's center-focused-column is global, so `watch` flips it by writing
~/.local/state/niri/center.kdl, which config.kdl includes. Workspace ids only last one
niri session, so `watch` starts with nothing aligned.
"""
import json
from pathlib import Path
import subprocess
import sys

STATE = Path.home() / ".local/state/niri"
ALIGNED = STATE / "aligned.json"
SPLIT = STATE / "split"  # id of the window the next one opens below
CENTER = STATE / "center.kdl"
CENTER_OFF = 'layout { center-focused-column "never"; }\n'


def niri(*args):
    return subprocess.run(["niri", "msg", *args], check=True, capture_output=True, text=True).stdout


def query(what):
    return json.loads(niri("--json", what))


def aligned():
    try:
        return set(json.loads(ALIGNED.read_text()))
    except (FileNotFoundError, ValueError):
        return set()


def save(ids):
    STATE.mkdir(parents=True, exist_ok=True)
    ALIGNED.write_text(json.dumps(sorted(ids)))


def apply(workspace_id):
    # Only touch center.kdl when it changes: every write makes niri reload its config.
    if workspace_id in aligned():
        if not CENTER.exists() or CENTER.read_text() != CENTER_OFF:
            STATE.mkdir(parents=True, exist_ok=True)
            CENTER.write_text(CENTER_OFF)
    else:
        CENTER.unlink(missing_ok=True)


def focused_workspace():
    return next(w["id"] for w in query("workspaces") if w["is_focused"])


def fit(workspace_id):
    columns = sorted({w["layout"]["pos_in_scrolling_layout"][0] for w in query("windows")
                      if w["workspace_id"] == workspace_id and not w["is_floating"]
                      and w["layout"].get("pos_in_scrolling_layout")})
    if not columns:
        return 0
    focused = query("focused-window")
    # set-column-width only acts on the focused column, so visit each one
    for column in columns:
        niri("action", "focus-column", str(column))
        niri("action", "set-column-width", f"{100 / len(columns):.4f}%")
    if focused:
        niri("action", "focus-window", "--id", str(focused["id"]))
    return len(columns)


def notify(message):
    subprocess.run(["notify-send", "-t", "1000", message], check=False)


def fit_focused():
    notify(f"fit {fit(focused_workspace())}")


def align():
    workspace = focused_workspace()
    ids = aligned()
    if workspace in ids:
        ids.discard(workspace)
        notify("auto-center")
    else:
        ids.add(workspace)
        notify("aligned")
    save(ids)
    apply(workspace)
    if workspace in ids:
        # Focusing the first column is what scrolls the row flush left.
        focused = query("focused-window")
        niri("action", "focus-column-first")
        if focused:
            niri("action", "focus-window", "--id", str(focused["id"]))
    else:
        niri("action", "center-column")


def split():
    if SPLIT.exists():
        SPLIT.unlink()
        notify("split cancelled")
        return
    focused = query("focused-window")
    if not focused:
        return notify("nothing to split")
    STATE.mkdir(parents=True, exist_ok=True)
    SPLIT.write_text(str(focused["id"]))
    notify("split ↓")


def column(window):
    return window["workspace_id"], (window["layout"].get("pos_in_scrolling_layout") or [None])[0]


def place_split(window):
    # niri can't open a window inside a column (FAQ), so it opens in a new column to
    # the right of the focused one and gets pulled left into the armed one.
    target = SPLIT.read_text().strip()
    SPLIT.unlink()
    if window["is_floating"]:
        return
    target = next((w for w in query("windows") if str(w["id"]) == target), None)
    workspace, index = column(window)
    # Only if the armed window's column is right next to it; focus may have moved since.
    if target and index is not None and column(target) == (workspace, index - 1):
        niri("action", "consume-or-expel-window-left", "--id", str(window["id"]))


def watch():
    save(set())
    SPLIT.unlink(missing_ok=True)
    apply(focused_workspace())
    stream = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                              stdout=subprocess.PIPE, text=True)
    known = set()
    for line in stream.stdout:
        event = json.loads(line)
        activated = event.get("WorkspaceActivated")
        if activated and activated["focused"]:
            apply(activated["id"])
        if "WindowsChanged" in event:
            known = {w["id"] for w in event["WindowsChanged"]["windows"]}
        if "WindowClosed" in event:
            known.discard(event["WindowClosed"]["id"])
        # Also fires on title changes; only a window not seen before is a new one.
        opened = event.get("WindowOpenedOrChanged", {}).get("window")
        if opened and opened["id"] not in known:
            known.add(opened["id"])
            if SPLIT.exists():
                place_split(opened)


if __name__ == "__main__":
    {"fit": fit_focused, "align": align, "split": split, "watch": watch}[sys.argv[1]]()

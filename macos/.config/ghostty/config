# Ghostty on the Mac: Rosé Pine Moon and Maple Mono, so the Mac never looks
# like the Linux box (Kanagawa + JetBrains Mono in foot).

# Font configuration
font-family = "Maple Mono NF"
font-size = 18

# Window configuration
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95

# Built-in theme; tuios (theme = 'none') takes its palette from here.
theme = Rose Pine Moon
